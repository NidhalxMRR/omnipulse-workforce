# ==========================================
# Remote Workforce Performance Tracker .env
# ==========================================

# Database Coordinates (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_NAME=workforce_tracker
DB_USER=postgres
DB_PASSWORD=postgres_secure_password_123
DATABASE_URL=postgresql://postgres:postgres_secure_password_123@db:5432/workforce_tracker

# Backend API & WebSocket Configuration
# PORT is used both inside the container and for the published host port.
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_for_startup_auth_2026
CORS_ORIGIN=http://localhost:3000

# Supervisor Frontend Configuration
# FRONTEND_PORT is the host port only; Vite always serves on 3000 in-container.
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000

# Client Extension Default Config
EXTENSION_SYNC_INTERVAL_SEC=15
IDLE_THRESHOLD_SEC=60
