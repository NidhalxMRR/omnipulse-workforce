{
  "manifest_version": 3,
  "name": "OmniPulse Agent Telemetry",
  "version": "1.0.0",
  "description": "Privacy-conscious Call Center & Browser Activity Monitor with WebRTC Call Detection",
  "permissions": [
    "tabs",
    "idle",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OmniPulse Agent Status"
  }
}
